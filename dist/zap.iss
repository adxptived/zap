; Script generated by the Inno Script Studio Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
#include "environment.iss"

#define MyAppName "Zap"
#ifndef MyAppVersion
  #define MyAppVersion "0.1.1"
#endif
#define MyAppPublisher "XtremeDevX"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{033D0649-03A3-4BF3-8700-4F054EC32FF6}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={localappdata}\Programs\Zap
DefaultGroupName={#MyAppName}
LicenseFile=..\LICENSE.txt
OutputDir=..\dist\output
OutputBaseFilename=Zap
UninstallDisplayName=Zap
Compression=lzma
SolidCompression=yes
PrivilegesRequired=lowest
ChangesEnvironment=yes
DisableDirPage=no
UsePreviousAppDir=no

[Messages]
SetupWindowTitle = Zap Setup

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\bin\zap.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\zapw.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\zapg.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\zapg.exe.manifest"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\zapw.exe.manifest"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\zap.ico"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\register-context-menu.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
Source: "..\bin\unregister-context-menu.exe"; DestDir: "{app}\bin"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
begin
    if CurStep = ssPostInstall 
     then EnvAddPath(ExpandConstant('{app}') +'\bin');
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
    if CurUninstallStep = usPostUninstall
    then EnvRemovePath(ExpandConstant('{app}') +'\bin');
end;

[Run]
Filename: "{app}\bin\register-context-menu.exe"; Flags: runascurrentuser;

[UninstallRun]
Filename: "{app}\bin\unregister-context-menu.exe"; Flags: runascurrentuser; RunOnceId: "UnregisterZapContextMenu"
